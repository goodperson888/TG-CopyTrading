# 仅配置 OKX 开发者 API 凭证，不需要钱包私钥/助记词。
# 复制为 .env 后建议 chmod 600 .env。不要发送至聊天或提交到 Git。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# 留空时，macOS / Windows 尝试读取当前已启用的系统 HTTP/HTTPS 代理；不改系统设置。
# 如果不要使用代理，填写 direct。HTTP CONNECT 代理示例：http://127.0.0.1:7890
OUTBOUND_PROXY=
PORT=8765

# 可选：项目内已安装固定版本官方 CLI；不需要配置钱包私钥。
# 官方登录会话保存在 data/agent-wallet，使用官方加密文件凭证存储，与全局账户分开。
ONCHAINOS_BIN=
# 可选：自有 RPC 提高回执可用性；留空使用公共节点。
SOLANA_RPC_URL=
BSC_RPC_URL=
